# ==============================================================================
# SENTINEL-AD: Tactical Defense & Immutable Forensics Ledger
# Global Environment Variables Template
# ==============================================================================

# --- BACKEND (FastAPI AI Engine) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pinata IPFS (Decentralized Tactical Vault)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# AI Model Inference Settings
AI_MODEL_DEVICE=cpu # or "cuda" if GPU is available
CONFIDENCE_THRESHOLD=0.85

# --- WEB3 & SMART CONTRACTS (Polygon Amoy Testnet) ---
# Network RPC (Chain ID: 80002)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_prefix
POLYGONSCAN_API_KEY=your_polygonscan_api_key_for_verification

# Deployed Contract Address (Populated after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# --- FRONTEND (Next.js Holo-Command Dashboard) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_APP_NAME="SENTINEL-AD Command Center"
